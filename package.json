{
  "name": "nodejs-hubspot-crm-integration",
  "version": "1.0.0",
  "description": "Modular Node.js integration with the HubSpot CRM API covering Contacts, Deals, Associations, Pipelines and Properties.",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.js tests/unit",
    "test:integration": "node scripts/run-tests.js tests/integration",
    "verify:requirements": "node scripts/verify-requirements.js",
    "verify:requirements:strict": "node scripts/verify-requirements.js --strict",
    "docs:matrix": "node scripts/verify-requirements.js --markdown > docs/REQUIREMENTS_MATRIX.md",
    "probe": "node scripts/probe-portal.js",
    "lint:commits": "commitlint --from main --to HEAD --verbose",
    "validate": "npm run lint && npm test && npm run verify:requirements",
    "fundamentals:callbacks": "node src/fundamentals/callbacks.js",
    "fundamentals:async": "node src/fundamentals/asyncAwait.js",
    "fundamentals:modules": "node src/fundamentals/main.js",
    "fundamentals:streams": "node src/utils/streams.js",
    "handler": "node src/api/hubSpotApiHandler.js",
    "example:contact-names": "node src/examples/01-list-contact-names.js",
    "example:create-contact": "node src/examples/02-create-contact.js",
    "example:create-deal": "node src/examples/03-create-deal.js",
    "example:associate": "node src/examples/04-associate-contact-to-deal.js",
    "example:sync-contacts": "node src/examples/05-sync-contacts.js",
    "example:sync-deals": "node src/examples/06-sync-deals.js",
    "example:errors": "node src/examples/07-error-handling.js",
    "example:workflow": "node src/examples/08-full-workflow.js"
  },
  "keywords": [
    "hubspot",
    "crm",
    "nodejs",
    "api-integration",
    "contacts",
    "deals",
    "associations"
  ],
  "author": "Juan Sebastian Perez",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3"
  }
}
