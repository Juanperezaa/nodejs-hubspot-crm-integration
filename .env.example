# ---------------------------------------------------------------------------
# HubSpot CRM Integration — environment template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must NEVER be committed.
#
#   cp .env.example .env
#
# Every variable below is read and validated once, at startup, by
# `src/config/env.js`. The process fails fast with an actionable message when a
# required variable is missing or malformed.
# ---------------------------------------------------------------------------

# --- Authentication (required) ---------------------------------------------
# Private App access token from:
#   HubSpot > Settings > Integrations > Private Apps > <your app> > Auth
# Click "Show token", then "Copy". The value starts with `pat-`.
#
# NOTE: this is the ACCESS TOKEN, not the Client Secret. The Client Secret is a
# UUID used only to validate incoming webhook signatures and cannot
# authenticate REST calls.
HUBSPOT_ACCESS_TOKEN=pat-naX-00000000-0000-0000-0000-000000000000

# --- On HUBSPOT_API_KEY ------------------------------------------------------
# The brief offers "HUBSPOT_ACCESS_TOKEN or HUBSPOT_API_KEY". There is no
# HUBSPOT_API_KEY here because HubSpot has discontinued API keys: the `hapikey`
# query parameter no longer authenticates any endpoint, so implementing that
# path would produce code that cannot work.
#
# The private app access token above is the supported equivalent, and is what
# the brief names first. Recorded as decision D7 in docs/DECISIONS.md.

# --- Portal identity (optional, used for documentation and assertions) -----
# Numeric portal / hub id. Visible in the HubSpot app URL.
HUBSPOT_PORTAL_ID=

# --- Deal defaults (required by createHubSpotDeal) -------------------------
# Internal IDs, not display labels. Discover them with `npm run probe`, which
# calls GET /crm/v3/pipelines/deals and prints every pipeline and stage id.
# Most portals ship with a pipeline literally called `default`.
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_ID=appointmentscheduled

# --- API surface (optional; sensible defaults applied when empty) ----------
HUBSPOT_BASE_URL=https://api.hubapi.com
# CRM object endpoints version. HubSpot is migrating to date-based versioning
# (e.g. 2026-09); `v3` remains supported and is what this project targets.
HUBSPOT_OBJECTS_API_VERSION=v3
# Associations endpoints version. `v4` is supported until March 2027.
HUBSPOT_ASSOCIATIONS_API_VERSION=v4

# --- Resilience tuning (optional) ------------------------------------------
# Per-request socket timeout in milliseconds.
HUBSPOT_REQUEST_TIMEOUT_MS=10000
# Total attempts for a retryable failure (1 = no retry).
HUBSPOT_MAX_RETRY_ATTEMPTS=5
# Base delay for exponential backoff, in milliseconds.
HUBSPOT_RETRY_BASE_DELAY_MS=500
# Upper bound for any single backoff wait, in milliseconds.
HUBSPOT_RETRY_MAX_DELAY_MS=30000
# Page size for cursor pagination. HubSpot caps CRM list endpoints at 100.
HUBSPOT_PAGE_SIZE=100

# --- Safety switch ---------------------------------------------------------
# Integration tests create and delete real records in the portal. They refuse
# to run unless this is explicitly set to `true`.
HUBSPOT_ALLOW_WRITE=false

# --- Logging ---------------------------------------------------------------
# One of: error | warn | info | debug
LOG_LEVEL=info
